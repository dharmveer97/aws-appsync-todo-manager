{
  "name": "aws-appsync-cdk-localstack",
  "version": "1.0.0",
  "description": "AWS AppSync Todo API with CDK and Floki support",
  "main": "index.js",
  "scripts": {
    "build": "tsc && tsc -p lib/appsync/resolvers/tsconfig.json && mkdir -p dist/lib/appsync && cp lib/appsync/schema.graphql dist/lib/appsync/schema.graphql",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "codegen": "amplify codegen",
    "deploy": "cdk deploy",
    "deploy:local": "./node_modules/.bin/cdkl deploy",
    "destroy": "cdk destroy",
    "destroy:local": "./node_modules/.bin/cdkl destroy",
    "synth": "cdk synth",
    "bootstrap": "cdk bootstrap",
    "bootstrap:local": "./node_modules/.bin/cdkl bootstrap",
    "floci:start": "docker compose up -d",
    "floci:stop": "docker compose down"
  },
  "keywords": [
    "aws",
    "appsync",
    "cdk",
    "floci",
    "graphql",
    "dynamodb"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "aws-cdk": "^2.133.0",
    "aws-cdk-lib": "^2.133.0",
    "constructs": "^10.3.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "cdk-local": "^0.16.3"
  },
  "dependencies": {
    "@aws-appsync/utils": "^2.0.3",
    "@aws-sdk/client-appsync": "^3.525.0",
    "@aws-sdk/client-dynamodb": "^3.525.0",
    "dotenv": "^16.4.5"
  }
}
